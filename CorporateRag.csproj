<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);SKEXP0010;SKEXP0070</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.45.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.45.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Ollama" Version="1.45.0-alpha" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove=".setup\**\*.cs" />
    <Content Remove=".setup\**\*" />
    <EmbeddedResource Remove=".setup\**\*" />
    <None Remove=".setup\**\*" />
    <Compile Remove="publish\**\*.cs" />
    <Content Remove="publish\**\*" />
    <EmbeddedResource Remove="publish\**\*" />
    <None Remove="publish\**\*" />
    <Compile Remove="docs\**\*.cs" />
    <Content Remove="docs\**\*" />
    <EmbeddedResource Remove="docs\**\*" />
    <None Remove="docs\**\*" />
    <Content Remove="hosted-ui\downloads\**\*" />
    <EmbeddedResource Remove="hosted-ui\downloads\**\*" />
    <None Remove="hosted-ui\downloads\**\*" />
    <Content Remove="data\**\*" />
    <EmbeddedResource Remove="data\**\*" />
    <None Remove="data\**\*" />
    <Content Remove="uploads\**\*" />
    <EmbeddedResource Remove="uploads\**\*" />
    <None Remove="uploads\**\*" />
    <EmbeddedResource Remove="wwwroot\.embedded-ui" />
    <Content Remove="wwwroot\.embedded-ui" />
    <None Remove="wwwroot\.embedded-ui" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="wwwroot\**\*.*" />
  </ItemGroup>
</Project>
